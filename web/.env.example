# Supabase — Project Settings → API (use the "anon public" key, never service_role)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Sentry (optional) — https://docs.sentry.io/platforms/javascript/guides/react/
# When empty, the app runs with no error tracking at all.
# VITE_SENTRY_DSN=https://example-public-key@o0.ingest.sentry.io/0
